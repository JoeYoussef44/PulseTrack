# Copy to .env and fill in. Never commit the filled-in file.

# ---- Database (Neon) ----
# DATABASE_URL: pooled connection (-pooler host) -> used at runtime by serverless
# DIRECT_URL:   direct connection            -> used by prisma migrate
DATABASE_URL=
DIRECT_URL=

# ---- Auth ----
AUTH_SECRET=
SEED_CLINICIAN_EMAIL=
SEED_CLINICIAN_PASSWORD=

# ---- App ----
APP_BASE_URL=

# ---- Email ----
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ---- Tier 2: FHIR ----
FHIR_BASE_URL=
FHIR_CANDIDATE_ID=
FHIR_API_KEY=

# ---- Tier 3: AI (optional) ----
# The trajectory summary on the patient page. Leave AI_API_KEY empty and the
# panel says the feature is not configured; everything else runs unchanged.
#
# AI_PROVIDER: gemini (default) or groq. Both are free and need no card.
# AI_BASE_URL / AI_MODEL: optional overrides. Defaults are set per provider in
#   lib/ai/config.ts — set AI_MODEL to whatever your console actually lists,
#   because model ids change more often than endpoints do.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
